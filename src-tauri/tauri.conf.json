{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Nexus Lite",
    "version":  "0.2.1",
    "identifier":  "cl.hackteck.kernel-ia",
    "build":  {
                  "beforeBuildCommand":  "pnpm run build",
                  "frontendDist":  "../build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "KERNEL IA - Asistente Inteligente",
                                    "width":  1100,
                                    "height":  750,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "center":  true,
                                    "decorations":  true,
                                    "resizable":  true,
                                    "url":  "index.html"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com; connect-src \u0027self\u0027 https://* http://localhost:* http://192.168.*:*; img-src \u0027self\u0027 data:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               }
}
